(version 1)

# JLCPCB 4-layer capabilities are the board's limits (jlcpcb.com/capabilities/pcb-capabilities, 2026-10). Board Setup
# holds what the project file can express (0.09 mm track and gap, 0.45/0.3 mm via, 0.2 mm hole to hole; every
# netclass at 0.1 mm clearance, JLC's pad-to-track minimum); the rest is here.
(rule jlc_hole_clearance
	(constraint hole_clearance (min 0.2mm)))
(rule jlc_annular_ring
	(constraint annular_width (min 0.15mm))
	(condition "A.Type != 'Via'"))

# Vias: JLC's included minimum is a 0.3 mm hole in a 0.45 mm pad (anything smaller costs more; Board Setup holds 0.45/0.3
# as the via minimum), a 0.075 mm ring. The 0.45 via is the one that fits inside an 0402 pad for via-in-pad.
(rule jlc_via_annular_ring
	(constraint annular_width (min 0.075mm))
	(condition "A.Type == 'Via'"))
(rule jlc_edge_clearance
	(constraint edge_clearance (min 0.2mm)))
(rule jlc_silk_text
	(layer "?.Silkscreen")
	(constraint text_height (min 1.0mm))
	(constraint text_thickness (min 0.15mm)))

# J1's own land pattern (GCT USB4105-GF-A): the GND pads A1/B12 and A12/B1 sit 0.1944 mm from the connector's two
# locating pegs (NPTH). The vendor's footprint, so the hole clearance is relaxed for J1 only.
(rule j1_land_pattern
	(constraint hole_clearance (min 0.19mm))
	(condition "A.Parent == 'J1' || B.Parent == 'J1'"))

# U1's exposed pad (nine pad-29 squares) sits in its own solid GND pour, U1_EPAD, stitched by vias. The board-wide
# GND pour can only reach each square with one thermal spoke past it, so the squares connect solid instead.
(rule u1_epad_solid
	(constraint zone_connection solid)
	(condition "A.Parent == 'U1' && A.Pad_Number == '29'"))

# The back-silk QR code is knocked out of a silk square whose 0.8 mm border is its quiet zone (white silk, like
# paper), so copper near the square does not touch the code's own margin: KiCad's 1 mm barcode separation is
# relaxed to the silk-to-copper spacing the rest of the silk keeps.
(rule qr_quiet_zone_in_silk
	(constraint physical_clearance (min 0.3mm))
	(condition "A.Type == 'Barcode' || B.Type == 'Barcode'"))
