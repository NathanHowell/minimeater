    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "f051c035-a4dc-4007-95b8-a37347dc9989")
  )
  (text "PROBE INPUTS 1..4 (J2..J5, TIP1..TIP4 -> AIN0..AIN3): 47k 0.1% bias to VREF_PROBE, 1k series, 100nF to GND"
